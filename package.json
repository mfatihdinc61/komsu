{
  "name": "smart-camera-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Demo: a CCTV camera that describes what it sees with Gemini and answers questions on web, Telegram and WhatsApp.",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "make-test-video": "ffmpeg -y -f lavfi -i testsrc2=size=640x360:rate=10 -t 30 -pix_fmt yuv420p test/sample.mp4"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@google/genai": "^2.23.0",
    "express": "^5.2.1",
    "jpeg-js": "^0.4.4"
  }
}
