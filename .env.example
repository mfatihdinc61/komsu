# Copy this file to .env and fill it in. Never commit .env.

# --- Server ---
PORT=3000
TIMEZONE=Europe/Istanbul

# --- Camera ---
# Any RTSP source. Example is a Hikvision DVR channel-1 substream (102).
# Use a limited live-view-only user. URL-encode special chars in the password (@ -> %40).
CAMERA_URL=rtsp://USER:PASS@CAMERA_HOST:554/Streaming/Channels/102
# For local testing without a camera: CAMERA_URL=test/sample.mp4  (npm run make-test-video)
CAMERA_LABEL=Demo camera
LIVE_FPS=2
LIVE_WIDTH=640

# --- Motion detection ---
# Fraction of the image (0-1) that must change to count as motion.
MOTION_MIN_AREA=0.02
# Above this fraction we assume a lighting change / IR switch and ignore it.
MOTION_MAX_AREA=0.6
# Per-pixel brightness difference (0-255) that counts as "changed".
MOTION_PIXEL_THRESHOLD=28
# Consecutive frames with motion before we react (filters noise).
MOTION_CONSECUTIVE=2

# --- Gemini (Google AI Studio) ---
# One key, or a comma-separated list for round-robin (free-tier quota is per key).
GOOGLE_AI_API_KEYS=
GEMINI_API_KEY=
# Primary model, then a comma-separated fallback chain (each model has its own
# per-day free-tier quota, so a busy/exhausted one rolls to the next).
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-flash-latest
# Minimum seconds between two scene descriptions (this is what controls API usage).
DESCRIBE_COOLDOWN_SEC=180
# Describe the scene at least this often even without motion (minutes, 0 = off).
HEARTBEAT_MIN=0
# Language used for scene descriptions (chat replies follow the user's language).
DESCRIPTION_LANGUAGE=Turkish
# How many recent events the chat sees.
CHAT_CONTEXT_EVENTS=60
# true = attach the current frame to every chat question (more accurate "now" answers, costs more).
CHAT_INCLUDE_FRAME=false
# Save the frame behind each event so detail questions (colour, clothing, count) can be re-analyzed.
FRAME_STORE=true
FRAMES_PER_EVENT=3
FRAME_KEEP_DAYS=14
FRAME_KEEP=5000
VISION_RECALL_FRAMES=3
# Max chat messages per user per 10 minutes.
CHAT_RATE_LIMIT=10
# true = fake AI responses, for testing without an API key.
MOCK_AI=false

# --- Proactive alerts (camera detects danger -> WhatsApp the frame) ---
# Comma-separated numbers to alert (international, digits only). e.g. 90XXXXXXXXXX
ALERT_WHATSAPP_NUMBERS=
ALERT_TYPES=smoking,fire,fall,fight,weapon,medical,intrusion,emergency
ALERT_COOLDOWN_SEC=300
# Approved WhatsApp utility template used when the recipient's 24h window is closed.
ALERT_TEMPLATE_NAME=emergency_alert
ALERT_TEMPLATE_LANG=tr

# --- Watch requests (privileged numbers set standing conditional alerts) ---
# Comma-separated international numbers allowed to say "X olursa haber ver". e.g. 90XXXXXXXXXX
WATCH_PRIVILEGED_NUMBERS=
# Min seconds between two notifications for the same watch.
WATCH_COOLDOWN_SEC=600
WATCH_MAX_ACTIVE=20

# --- Page ---
CONTACT_URL=mailto:you@example.com

# --- Telegram (from @BotFather) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# --- WhatsApp Cloud API (Meta) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=choose-a-random-string
# Public number in international format without + (for the wa.me link), e.g. 905551112233
WHATSAPP_PUBLIC_NUMBER=
WHATSAPP_GRAPH_VERSION=v23.0
# Public HTTPS URL Meta delivers inbound messages to; set as the WABA override on boot.
WHATSAPP_WEBHOOK_URL=
